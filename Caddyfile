{
    # Global options
}

:80 {
    # Self-hosted Supabase stack (see docker-compose.yml). These paths match
    # exactly what Supabase's own Kong gateway routes, so the supabase_flutter
    # SDK and supabase-py client need no path changes, only a new SUPABASE_URL.
    #
    # Hosted Supabase's Kong gateway adds CORS headers automatically. Here,
    # GoTrue and PostgREST already emit their own permissive
    # Access-Control-Allow-Origin: * on real responses (fine — the
    # supabase-js client authenticates via Bearer token, not cookies, so
    # credentialed CORS isn't needed), but neither handles OPTIONS preflight
    # requests correctly, and Storage emits no CORS headers at all.
    @cors_preflight method OPTIONS
    handle @cors_preflight {
        header Access-Control-Allow-Origin "{http.request.header.Origin}"
        header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
        header Access-Control-Allow-Headers "{http.request.header.Access-Control-Request-Headers}"
        header Access-Control-Max-Age "3600"
        respond 204
    }

    handle_path /auth/v1/* {
        reverse_proxy auth:9999
    }

    handle_path /rest/v1/* {
        reverse_proxy rest:3000
    }

    handle_path /storage/v1/* {
        header Access-Control-Allow-Origin "{http.request.header.Origin}"
        reverse_proxy storage:5000
    }

    # Reverse proxy to our FastAPI container
    handle {
        reverse_proxy api:8080 {
            # Preserve and forward original client IP chain for app-side GeoIP lookup.
            # Caddy's defaults may overwrite X-Forwarded-For in some ingress chains.
            header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
            header_up X-Real-IP {http.request.remote.host}
        }
    }

    # Compression is already handled by our backend Brotli middleware,
    # but Caddy can also handle Gzip as a fallback if needed.
    encode gzip zstd

    # Logging
    log {
        output file /var/log/caddy/access.log
    }
}
