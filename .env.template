# ── Database & Cache ──────────────────────────────────────────
# Supabase Postgres connection string (Transaction mode or Direct)
# Format: postgresql://postgres:[PASSWORD]@db.trfqhobnkgtfccrdsexa.supabase.co:5432/postgres
DATABASE_URL=

# Redis connection string (for caching)
# Use redis://redis:6379 for Docker, or redis://localhost:6379 for local dev
REDIS_URL=redis://localhost:6379

# ── Supabase ──────────────────────────────────────────────────
# Hosted: found in Supabase Dashboard > Project Settings > API.
# Self-hosted (home server): the public URL Caddy/Cloudflare Tunnel exposes
# (e.g. https://currenta.tech) plus the keys generated below.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Self-hosted Supabase stack (home server only) ───────────────
# Not used when SUPABASE_URL points at a hosted *.supabase.co project.
# Generate fresh per deployment — never reuse Supabase's public example keys:
#   POSTGRES_PASSWORD / JWT_SECRET: `openssl rand -base64 32`
#   SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY (above): HS256 JWTs signed
#     with JWT_SECRET, containing {"role": "anon"|"service_role", "iss": "supabase"}.
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRY=3600
SUPABASE_SITE_URL=https://currenta.tech
SUPABASE_ADDITIONAL_REDIRECT_URLS=
# GoTrue (self-hosted Auth) has no built-in mailer — needs a real SMTP relay
# for signup confirmation / password reset emails (Mailtrap's SMTP sending
# integration, not the sandbox one above).
GOTRUE_SMTP_HOST=
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=
GOTRUE_SMTP_PASS=

# ── Security ──────────────────────────────────────────────────
# Change this to a strong random string for production.
ADMIN_API_KEY=

# Proxy/IP trust settings.
# In Cloud Run set TRUST_PROXY_HEADERS=true. Optionally set TRUSTED_PROXY_IPS
# to a comma-separated list of trusted proxy peer IPs if your ingress path is fixed.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=

# ── LLM / Local API ───────────────────────────────────────────
# Defaults to localhost since the backend and Ollama are on the same machine.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# ── Embeddings ────────────────────────────────────────────────
# Supported providers: openai, voyage
EMBEDDING_PROVIDER=voyage

# OpenAI (used when EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# Voyage (used when EMBEDDING_PROVIDER=voyage)
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-4-lite

# ── Email (Mailtrap) ──────────────────────────────────────────
MAILTRAP_TOKEN=
USE_MAILTRAP_SANDBOX=true
MAILTRAP_SENDER_EMAIL=no-reply@currenta.tech
MAILTRAP_SENDER_NAME=Currenta

# Mailtrap Sandbox (for local dev)
MAILTRAP_SANDBOX_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SANDBOX_PORT=2525
MAILTRAP_SANDBOX_USER=
MAILTRAP_SANDBOX_PASS=

# ── Security ──────────────────────────────────────────────────
# Disable App Check for local development (dev/profile builds)
DISABLE_APP_CHECK=true
