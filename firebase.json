{
    "hosting": {
        "public": "landing/dist",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "predeploy": [
            "npm --prefix landing run build"
        ],
        "headers": [
            {
                "source": "/assets/**",
                "headers": [
                    { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
                ]
            },
            {
                "source": "**/*.@(js|css|woff2|webp|jpg|png|svg|ico)",
                "headers": [
                    { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
                ]
            },
            {
                "source": "**/*.html",
                "headers": [
                    { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
                ]
            }
        ]
    },
    "flutter": {
        "platforms": {
            "android": {
                "default": {
                    "projectId": "currenta-prod",
                    "appId": "1:1061629660004:android:72427bc730ce51a297c871",
                    "fileOutput": "android/app/google-services.json"
                }
            },
            "dart": {
                "lib/firebase_options.dart": {
                    "projectId": "currenta-3d240",
                    "configurations": {
                        "android": "1:703509294568:android:3d9c51155a1c2c9597c85d",
                        "ios": "1:703509294568:ios:e629bbf2036f488d97c85d"
                    }
                },
                "lib/firebase_options_dev.dart": {
                    "projectId": "currenta-3d240",
                    "configurations": {
                        "android": "1:703509294568:android:28a6a2d936275ef697c85d",
                        "ios": "1:703509294568:ios:e629bbf2036f488d97c85d"
                    }
                },
                "lib/firebase_options_prod.dart": {
                    "projectId": "currenta-prod",
                    "configurations": {
                        "android": "1:1061629660004:android:72427bc730ce51a297c871",
                        "ios": "1:1061629660004:ios:cac40c799f2698c297c871"
                    }
                }
            }
        }
    }
}
