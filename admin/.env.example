# Copy to .env.local (gitignored) for local dev. Vite's `npm run build` reads
# .env.production instead — keep both in sync, since the admin portal always
# talks to the home server's self-hosted stack (dev-api.currenta.tech)
# regardless of where the portal itself is deployed (see CLAUDE.md).
VITE_API_BASE_URL=https://dev-api.currenta.tech
VITE_SUPABASE_URL=https://dev-api.currenta.tech
VITE_SUPABASE_ANON_KEY=
