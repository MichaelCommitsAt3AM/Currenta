# openapi-typescript@7 peer-depends on typescript@^5.x, but the react-ts
# Vite template pulls in typescript@6.x. It's a dev-only codegen CLI
# (invoked via `npm run gen:types`, never imported into the app bundle),
# so the mismatch has zero runtime effect — safe to bypass here rather
# than pin typescript back a major version for one devDependency.
legacy-peer-deps=true
